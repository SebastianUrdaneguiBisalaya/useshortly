# Base URL of the backend. Leave empty in development: Vite proxies /api to VITE_API_PROXY_TARGET.
VITE_API_URL=

# Where Vite forwards /api in development.
VITE_API_PROXY_TARGET=http://localhost:8080

# Google OAuth client id for "Continue with Google"; same value as the backend GOOGLE_CLIENT_ID. Leave empty to hide the button.
VITE_GOOGLE_CLIENT_ID=
