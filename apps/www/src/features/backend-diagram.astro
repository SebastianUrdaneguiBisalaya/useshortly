---
import { Database, MousePointerClick, Server, Zap } from "@lucide/astro";

import Typography from "../components/ui/typography.astro";

// Mirrors the redirect path in the Go API: `LinkHandler.Redirect` resolves the code through the Redis cache
// (`cached.LinkRepository`), falls back to SQLite on a miss, answers 302, and hands the click to
// `analytics.Recorder`, whose worker adds country and device and writes it after the response is sent.
// The click matches the MCP chat and the dashboard: Instagram, Peru, mobile.
const record = [
	{ key: "time", value: "14:02 UTC" },
	{ key: "referrer", value: "instagram.com" },
	{ key: "country", value: "Peru" },
	{ key: "device", value: "Mobile" },
];
---

<figure
	data-backend-diagram
	class="flex h-full flex-col justify-center px-4 py-16 md:px-12 md:py-32"
	aria-label="A visit to a short link reaches the Go API, which reads the Redis cache and falls back to SQLite on a miss, answers 302 Found, and records the click in the background with its time, referrer, country and device"
>
	<div aria-hidden="true" class="flex flex-col">
		<div data-step class="mx-auto flex items-center gap-2 border border-black/15 bg-cream px-3 py-2">
			<MousePointerClick size={14} class="text-black/60" />
			<Typography as="span" variant="caption" font="primary">GET go.example.com/aB3xY9z</Typography>
		</div>

		<div class="mx-auto h-10 border-l border-black/30"></div>

		<div class="grid grid-cols-[1fr_auto_1fr] items-start">
			<div data-step class="flex items-start">
				<div class="flex flex-col items-center gap-2">
					<span class="flex size-12 items-center justify-center border border-dashed border-black/15 bg-cream">
						<Zap size={18} />
					</span>
					<Typography as="span" variant="caption" class="text-black/60">Redis</Typography>
				</div>
				<div class="relative mt-6 flex-1 border-t border-dashed border-black/30">
					<Typography as="span" variant="caption" class="absolute inset-x-0 -top-5 text-center text-black/60">
						1. cache
					</Typography>
				</div>
			</div>

			<div data-step class="flex flex-col items-center gap-2">
				<span class="flex size-12 items-center justify-center bg-black text-cream">
					<Server size={20} />
				</span>
				<Typography as="span" variant="caption" class="text-black/60">Go API</Typography>
			</div>

			<div data-step class="flex items-start">
				<div class="relative mt-6 flex-1 border-t border-dashed border-black/30">
					<Typography as="span" variant="caption" class="absolute inset-x-0 -top-5 text-center text-black/60">
						2. on a miss
					</Typography>
				</div>
				<div class="flex flex-col items-center gap-2">
					<span class="flex size-12 items-center justify-center border border-dashed border-black/15 bg-cream">
						<Database size={18} />
					</span>
					<Typography as="span" variant="caption" class="text-black/60">SQLite</Typography>
				</div>
			</div>
		</div>

		<!-- From the API down: the solid wire is the visitor's answer, the dashed one the background write. -->
		<svg class="h-16 w-full text-black/30" viewBox="0 0 100 40" preserveAspectRatio="none">
			<path data-wire d="M50 0 C 50 22, 25 18, 25 40" fill="none" stroke="currentColor" vector-effect="non-scaling-stroke" />
			<path
				data-wire
				d="M50 0 C 50 22, 75 18, 75 40"
				fill="none"
				stroke="currentColor"
				stroke-dasharray="4 4"
				vector-effect="non-scaling-stroke"
			/>
		</svg>

		<div class="grid grid-cols-2 gap-4">
			<div data-step class="flex flex-col gap-2 border border-black/15 bg-cream p-4">
				<Typography as="span" variant="caption" class="text-black/60">The visitor gets</Typography>
				<Typography as="span" variant="h5" font="primary" weight="normal">302 Found</Typography>
				<Typography as="span" variant="caption" font="primary" class="wrap-break-word text-black/60">
					Location: example.com/launch
				</Typography>
			</div>
			<div data-step class="flex flex-col gap-2 border border-dashed border-black/30 p-4">
				<Typography as="span" variant="caption" class="text-black/60">Saved after the redirect</Typography>
				<dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
					{
						record.map((field) => (
							<div data-field class="contents">
								<dt>
									<Typography as="span" variant="caption" font="primary" class="text-black/45">
										{field.key}
									</Typography>
								</dt>
								<dd class="min-w-0">
									<Typography as="span" variant="caption" font="primary" class="wrap-break-word">
										{field.value}
									</Typography>
								</dd>
							</div>
						))
					}
				</dl>
			</div>
		</div>
	</div>
</figure>

<script>
	import { gsap } from "gsap";

	// Plays the visit once when the diagram comes into view: request, cache, database, the 302, then the click
	// record filling in field by field. Reduced motion (or no JS) shows the finished diagram.
	const figure = document.querySelector<HTMLElement>("[data-backend-diagram]");

	if (figure && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
		const q = gsap.utils.selector(figure);
		const timeline = gsap.timeline({ paused: true, defaults: { duration: 0.4, ease: "power2.out" } });

		timeline
			.from(q("[data-step]"), { opacity: 0, y: 8, stagger: 0.25 })
			.from(q("[data-wire]"), { opacity: 0, stagger: 0.15 }, "<0.9")
			.from(q("[data-field] dd"), { opacity: 0, x: -4, stagger: 0.2 }, "+=0.3");

		const observer = new IntersectionObserver(
			([entry]) => {
				if (entry?.isIntersecting) {
					timeline.play();
					observer.disconnect();
				}
			},
			{ threshold: 0.4 },
		);
		observer.observe(figure);
	}
</script>
