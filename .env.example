# Ed25519 public key (PEM, or base64 of the raw 32 bytes) of the MCP server. Empty disables MCP access.
# Generate the pair with: openssl genpkey -algorithm ED25519 -out mcp-private.pem && openssl pkey -in mcp-private.pem -pubout
MCP_PUBLIC_KEY=
