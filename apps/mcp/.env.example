ENVIRONMENT=development
PORT=4001
# Public base URL of this server (OAuth issuer and MCP resource). https in production.
MCP_PUBLIC_URL=http://localhost:4001
# Base URL of the useshortly API, without /api/v1.
API_URL=http://localhost:8080
# Generate MCP_SIGNING_KEY and AUTH_SECRET with `pnpm keygen`; it also prints the API's MCP_PUBLIC_KEY.
MCP_SIGNING_KEY=
AUTH_SECRET=
# Better Auth database: its own SQLite file; set both Turso values to sync it with Turso Cloud.
MCP_DATABASE_PATH=data/mcp.db
MCP_TURSO_DATABASE_URL=
MCP_TURSO_AUTH_TOKEN=
MCP_SYNC_INTERVAL_SECONDS=30
# Same Google OAuth client as the API; leave empty to hide "Continue with Google".
GOOGLE_CLIENT_ID=
# true behind a reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
TRUSTED_ORIGINS=
