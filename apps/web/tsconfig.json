{
	"extends": "../../tsconfig.base.json",
	"include": ["**/*", "**/.server/**/*", "**/.client/**/*", ".react-router/types/**/*"],
	"compilerOptions": {
		"lib": ["DOM", "DOM.Iterable", "ES2023"],
		"types": ["node", "vite/client"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"noUncheckedIndexedAccess": false,
		"rootDirs": [".", "./.react-router/types"],
		"paths": {
			"~/*": ["./src/*"]
		}
	}
}
