---
import Typography from './typography.astro';

type Props = {
	items: { value: string; title: string; description: string }[];
};

const { items } = Astro.props as Props;
---

<ul class="flex flex-col divide-y divide-dashed divide-black/15">
	{
		items.map((item) => (
			<li class="grid grid-cols-[5rem_1fr] items-baseline gap-6 py-6 first:pt-0 last:pb-0 sm:grid-cols-[7rem_1fr]">
				<Typography as="span" variant="h2" weight="normal" class="leading-none">
					{item.value}
				</Typography>
				<div class="flex flex-col gap-1">
					<Typography as="span" variant="body" weight="medium">
						{item.title}
					</Typography>
					<Typography as="span" variant="small" class="text-black/60">
						{item.description}
					</Typography>
				</div>
			</li>
		))
	}
</ul>
