---
import Layout from "../components/ui/layout.astro";
import Typography from "../components/ui/typography.astro";

const steps = [
	{
		numeral: "I",
		title: "Deploy",
		description: "Clone the repo and start it with Docker Compose. A single SQLite file holds everything, with optional Turso sync",
		command: "docker compose up -d",
		output: "✓ Container useshortly-app-1 Started",
	},
	{
		numeral: "II",
		title: "Shorten",
		description: "Create links on your own domain from the dashboard, the REST API or an AI assistant through MCP",
		command: "curl -X POST go.example.com/api/links",
		output: '{ "short_url": "go.example.com/x7Kp2aQ" }',
	},
	{
		numeral: "III",
		title: "Measure",
		description: "Every click reaches your server first, so you see its time, referrer, country and device",
		command: "curl -I go.example.com/x7Kp2aQ",
		output: "HTTP/1.1 302 Found",
	},
];
---

<Layout
	as="section"
	id="how-it-works"
	class="scroll-mt-16"
	frameClass="grid divide-y divide-dashed divide-black/15 md:grid-cols-[22rem_1fr] md:divide-x md:divide-y-0"
>
	<div class="flex flex-col gap-4 px-4 py-16 md:px-12 md:py-32">
		<Typography as="span" variant="caption" class="text-black/60">How it works</Typography>
		<Typography as="h2" variant="h3">From clone to first short link, in three steps.</Typography>
	</div>

	<ol class="grid gap-12 px-4 py-16 sm:grid-cols-3 sm:gap-y-0 md:px-12 md:py-32">
		{
			steps.map((step) => (
				// Subgrid shares the parent's rows, so the terminals (and titles) line up at the height of the tallest one.
				<li class="flex flex-col gap-3 sm:row-span-4 sm:grid sm:grid-rows-subgrid sm:gap-y-3">
					<div class="mb-6 flex min-h-32 flex-col border border-black/10 bg-black/3 text-black" aria-hidden="true">
						<div class="flex gap-1.5 border-b border-black/10 px-3 py-2">
							<span class="size-2 bg-black/15" />
							<span class="size-2 bg-black/15" />
							<span class="size-2 bg-black/15" />
						</div>
						<div class="flex flex-1 flex-col justify-center gap-2 px-3 py-4">
							<Typography as="span" variant="caption" font="primary" class="wrap-break-word">
								<span class="text-black/40">$</span> {step.command}
							</Typography>
							<Typography as="span" variant="caption" font="primary" class="wrap-break-word text-black/40">
								{step.output}
							</Typography>
						</div>
					</div>
					<Typography as="span" variant="caption" class="text-black/60" aria-hidden="true">
						{step.numeral}
					</Typography>
					<Typography as="h3" variant="h5" font="secondary" weight="medium">
						{step.title}
					</Typography>
					<Typography variant="small" class="text-black/60">
						{step.description}
					</Typography>
				</li>
			))
		}
	</ol>
</Layout>
