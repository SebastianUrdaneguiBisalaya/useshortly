ENVIRONMENT=development
PORT=8080
DATABASE_PATH=useshortly.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
REDIS_URL=
SYNC_INTERVAL=30s
JWT_SECRET=
JWT_TTL=24h
# Public URL of the app. With https the session cookies are marked Secure. The web app and the API must share the same site (cookies are SameSite).
APP_URL=http://localhost:8080
RESEND_API_KEY=
MAIL_FROM=
OTP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=postmessage
# "Desktop app" OAuth client (Google console) for the desktop app's sign-in through the system browser. Empty disables Google there.
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=
REFRESH_TTL=720h
LINK_CACHE_TTL=5m
GEOIP_DB_PATH=
TRUST_PROXY=false
ABUSE_EMAIL=
RATE_LIMIT=true
# Ed25519 public key (PEM, or base64 of the raw 32 bytes) of the MCP server. Empty disables MCP access.
# Generate the pair with: openssl genpkey -algorithm ED25519 -out mcp-private.pem && openssl pkey -in mcp-private.pem -pubout
MCP_PUBLIC_KEY=
