# Development image for docker-compose.dev.yml: dependencies are installed here, the source is
# mounted from the host and tsx restarts the server when it changes.
FROM node:24-bookworm-slim
RUN npm install -g pnpm@12.15.0
WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/mcp/package.json ./apps/mcp/
RUN pnpm install --frozen-lockfile --filter @useshortly/mcp
WORKDIR /app/apps/mcp
CMD ["pnpm", "dev"]
