---
import type { Polymorphic } from "astro/types";
import { cva, type VariantProps } from "class-variance-authority";

import { cn } from "../lib/tailwind/cn";

type TypographyTag =
	| "h1"
	| "h2"
	| "h3"
	| "h4"
	| "h5"
	| "h6"
	| "p"
	| "span"
	| "small"
	| "strong"
	| "em"
	| "label"
	| "blockquote";

const typographyVariants = cva("", {
	variants: {
		/** Visual size, decoupled from the tag so an `h2` can look like an `h4` without breaking the outline. */
		variant: {
			display: "text-5xl md:text-7xl leading-none tracking-tight text-balance",
			h1: "text-4xl md:text-6xl leading-tight tracking-tight text-balance",
			h2: "text-3xl md:text-5xl leading-tight tracking-tight text-balance",
			h3: "text-2xl md:text-4xl leading-snug tracking-tight text-balance",
			h4: "text-xl md:text-2xl leading-snug text-balance",
			h5: "text-lg md:text-xl leading-snug",
			h6: "text-base md:text-lg leading-snug",
			lead: "text-lg md:text-xl leading-relaxed text-pretty",
			body: "text-base leading-relaxed text-pretty",
			small: "text-sm leading-normal",
			caption: "text-xs leading-normal tracking-wide",
		},
		font: {
			primary: "font-primary",
			secondary: "font-secondary",
		},
		weight: {
			normal: "font-normal",
			medium: "font-medium",
			bold: "font-bold",
		},
	},
});

type TypographyVariants = VariantProps<typeof typographyVariants>;
type Variant = NonNullable<TypographyVariants["variant"]>;

type Props = Polymorphic<{ as: TypographyTag }> & TypographyVariants;

const defaultVariant: Record<TypographyTag, Variant> = {
	h1: "h1",
	h2: "h2",
	h3: "h3",
	h4: "h4",
	h5: "h5",
	h6: "h6",
	p: "body",
	span: "body",
	small: "small",
	strong: "body",
	em: "body",
	label: "small",
	blockquote: "lead",
};

const { as: Tag = "p", variant, font, weight, class: className, ...rest } = Astro.props as Props;

// Defaults depend on the tag, so they're resolved here instead of in cva's `defaultVariants`.
const isHeading = /^h[1-6]$/.test(Tag);
---

<Tag
	class={cn(
		typographyVariants({
			variant: variant ?? defaultVariant[Tag],
			font: font ?? (isHeading ? "primary" : "secondary"),
			weight: weight ?? (isHeading || Tag === "strong" ? "bold" : "normal"),
		}),
		Tag === "em" && "italic",
		Tag === "blockquote" && "pl-4 italic",
		className,
	)}
	{...rest}
>
	<slot />
</Tag>
